# 飞脑配置（复制为 .env 后填值；不要提交到 Git）
# 生效位置：feinao-agent/.env（本机）或 /opt/feinao-agent/.env（服务器）
# 填完重启进程或 `systemctl restart fei-feinao-agent` 生效。
#
# 供应商降级链按 spec.json 的 providers 顺序：qwen → deepseek → hunyuan → mock
# 任一 Key 缺失就自动跳过，全部缺失时用 mock 兜底（功能可用，回答质量弱）

# ---- LLM Key（至少填一个才是真回答） ----
# qwen：阿里云百炼 DashScope，OpenAI 兼容协议
#   控制台 bailian.console.aliyun.com → API-KEY 管理
#   模型 qwen-flash（默认）/ qwen-plus / qwen-max，改 spec.json 里 qwen 的 model 字段即可
FEINAO_QWEN_KEY=
FEINAO_DEEPSEEK_KEY=
FEINAO_HUNYUAN_KEY=

# ---- 演示模式 ----
# 1（默认）：内置假上游（:8099）+ 示例知识文档，clone 后开箱可用
# 0：走 spec.json 里每个 upstream 的 base，接你自己的 KMS / BI / 工单系统
FEINAO_DEMO=1
# FEINAO_DEMO_PORT=8099

# ---- 上游地址覆盖（优先级高于 spec.json 的 base / demo_base） ----
# FEINAO_UPSTREAM_KMS=http://10.0.0.8:8050/kms/
# FEINAO_UPSTREAM_BI=http://10.0.0.8:8041/bi/
# FEINAO_UPSTREAM_CC=http://10.0.0.8:8043/cc/

# ---- 账号口令覆盖（仅对新建库生效；已有库请直接改 users 表） ----
# 出厂口令 admin123 / ops123456 / view123456 只用于本地演示，
# 对外暴露前务必替换，否则等于把管理台挂在公网上。
# FEINAO_PASS_ADMIN=
# FEINAO_PASS_OPS01=
# FEINAO_PASS_VIEW01=

# ---- 其他 ----
# FEINAO_PORT=8060
# FEINAO_DB=/opt/feinao-agent/feinao.db
# FEINAO_ENV_FILE=/etc/feinao.env
