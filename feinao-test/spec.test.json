{
  "brand": {
    "name": "飞脑·本地测试",
    "full": "飞脑AI Agent网关（本地测试 8081）",
    "tagline": "与生产同构 · 数据是假的",
    "port": 8081
  },
  "users": {
    "admin": "admin123",
    "ops01": "ops123456",
    "view01": "view123456",
    "editor01": "edit123456"
  },
  "providers": [
    {
      "name": "qwen",
      "type": "openai",
      "base": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
      "model": "qwen-flash",
      "key_env": "FEINAO_QWEN_KEY"
    },
    {
      "name": "deepseek",
      "type": "openai",
      "base": "https://api.deepseek.com/v1/chat/completions",
      "model": "deepseek-chat",
      "key_env": "FEINAO_DEEPSEEK_KEY"
    },
    {
      "name": "hunyuan",
      "type": "openai",
      "base": "https://api.hunyuan.cloud.tencent.com/v1/chat/completions",
      "model": "hunyuan-turbos-latest",
      "key_env": "FEINAO_HUNYUAN_KEY"
    },
    {
      "name": "mock",
      "type": "mock"
    }
  ],
  "upstreams": {
    "kms": {
      "label": "飞知KMS（本地假上游）",
      "base": "http://127.0.0.1:8199/kms/",
      "demo_base": "http://127.0.0.1:8199/kms/",
      "user": "admin",
      "pass": "local-only"
    },
    "bi": {
      "label": "飞瞰BI（本地假上游）",
      "base": "http://127.0.0.1:8199/bi/",
      "demo_base": "http://127.0.0.1:8199/bi/",
      "user": "admin",
      "pass": "local-only"
    },
    "cc": {
      "label": "飞音客服（本地假上游）",
      "base": "http://127.0.0.1:8199/cc/",
      "demo_base": "http://127.0.0.1:8199/cc/",
      "user": "admin",
      "pass": "local-only"
    }
  },
  "demo": {
    "default": true,
    "upstream_port": 8199,
    "seed_docs": true
  },
  "pilots": {
    "rag_topk": 5,
    "nl2api_max_rows": 50,
    "react_max_steps": 6
  },
  "modes": {
    "default": "default",
    "definitions": {
      "plan": {
        "read": "allow",
        "write": "suspend",
        "dangerous": "deny"
      },
      "default": {
        "read": "allow",
        "write": "confirm",
        "dangerous": "confirm"
      },
      "auto": {
        "read": "allow",
        "write": "confirm",
        "dangerous": "confirm"
      },
      "yolo": {
        "read": "allow",
        "write": "allow",
        "dangerous": "allow"
      }
    },
    "yolo_allowed_roles": [
      "admin"
    ]
  },
  "limits": {
    "max_steps": 20,
    "max_wall_clock_seconds": 600,
    "same_call_repeat_limit": 3,
    "malformed_json_limit": 2
  },
  "egress": {
    "enabled": true,
    "allow_schemes": [
      "http",
      "https"
    ],
    "allow_domains": [
      "dashscope.aliyuncs.com",
      "api.deepseek.com",
      "api.hunyuan.cloud.tencent.com"
    ],
    "allow_ports": [
      80,
      443
    ],
    "trust_upstream_origins": true,
    "deny_private_networks": true,
    "deny_metadata_endpoints": true,
    "max_response_bytes": 5242880,
    "request_timeout_seconds": 15
  },
  "approval": {
    "name": "飞审审批工作台（测试）",
    "approvers": [
      "admin"
    ],
    "allow_self": true,
    "ttl_minutes": 1440
  },
  "memory": {
    "name": "飞忆·跨会话长期记忆（测试）",
    "inject_topk": 3,
    "min_score": 1,
    "auto_activate_min": 1.0,
    "max_text": 140
  },
  "tool_policies": {
    "search_docs": {
      "class": "read",
      "max_calls_per_run": 3,
      "roles": [
        "admin",
        "ops",
        "viewer"
      ],
      "requires_confirm": false,
      "timeout_seconds": 10
    },
    "query_system": {
      "class": "read",
      "max_calls_per_run": 2,
      "roles": [
        "admin",
        "ops"
      ],
      "requires_confirm": false,
      "timeout_seconds": 15
    },
    "ingest_doc": {
      "class": "write",
      "max_calls_per_run": 1,
      "roles": [
        "admin",
        "ops"
      ],
      "requires_confirm": true,
      "timeout_seconds": 30
    }
  }
}
